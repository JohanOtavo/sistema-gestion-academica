@startgantt 08-roadmap-sprints
skinparam dpi 160
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam backgroundColor #FFFFFF

<style>
ganttDiagram {
  task {
    BackgroundColor #DCE6F1
    LineColor #2E75B6
    FontColor #1F3864
  }
  milestone {
    BackgroundColor #1F3864
    LineColor #1F3864
    FontColor #1F3864
  }
  separator {
    BackgroundColor #F2F2F2
    LineColor #BFBFBF
    FontColor #1F3864
    FontStyle bold
  }
  note {
    BackgroundColor #FFF2CC
    LineColor #BF9000
  }
}
</style>

printscale weekly
Project starts 2026-09-07
saturday are closed
sunday are closed

