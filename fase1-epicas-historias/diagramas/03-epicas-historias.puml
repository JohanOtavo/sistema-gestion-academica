  BackgroundColor #E2F0D9
  BorderColor #548235
  FontColor #375623
}
skinparam rectangle<<v2>> {
  BackgroundColor #F2F2F2
  BorderColor #A6A6A6
  FontColor #595959
}

rectangle "Sistema de Gestión\nAcadémica\n(SGA)" <<raiz>> as R

rectangle "EP-01\nAcceso y seguridad" <<epica>> as EP1
