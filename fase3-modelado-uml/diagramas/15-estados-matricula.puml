@startuml 15-estados-matricula
!pragma layout smetana
skinparam dpi 160
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #1F3864
skinparam ArrowFontSize 11
skinparam state {
  BackgroundColor #F7FAFE
  BorderColor #2E75B6
  FontColor #1F3864
  FontStyle bold
  AttributeFontSize 11
  AttributeFontColor #404040
}
skinparam note {
  BackgroundColor #FFF2CC
  BorderColor #BF9000
}

title Ciclo de vida de la Matrícula

[*] --> Activa : matricular()\n[RN-04, RN-05, RN-06, RN-07, RN-14]\n/ curso.ocuparCupo()

state Activa {
  Activa : entry / fechaMatricula = ahora
  Activa : entry / usuarioRegistro = sesion
  Activa : do / admite registro de calificaciones
  Activa : exit / se cierra el registro de notas
}

state Cancelada {
  Cancelada : entry / curso.liberarCupo() [RN-16]
  Cancelada : entry / auditar la cancelación
  Cancelada : do / conserva las notas registradas
}

state Finalizada {
  Finalizada : entry / calcularDefinitiva() [RN-11]
  Finalizada : entry / determinarAprobacion() [RN-12]
  Finalizada : do / solo lectura [RN-17]
}

Activa --> Cancelada : cancelar()\n[período abierto]
Activa --> Finalizada : cerrarPeriodo()\n[notas completas]
Cancelada --> [*]
Finalizada --> [*]

note right of Activa
  Solo en este estado la matrícula
  ocupa un cupo del curso y aparece
  en la lista de clase
end note

note bottom of Finalizada
  El administrador puede reabrir el período
  dejando constancia del motivo; la matrícula
  regresa entonces a Activa
end note
@enduml
