@startuml 05-clases-vista-general
!pragma layout smetana
skinparam dpi 160
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #1F3864
skinparam ArrowFontSize 11
skinparam class {
  BorderColor #2E75B6
  BackgroundColor #FFFFFF
  FontColor #1F3864
  HeaderBackgroundColor #DEEBF7
  AttributeFontColor #404040
  AttributeFontSize 11
}
skinparam enum {
  BorderColor #BF9000
  BackgroundColor #FFF9E6
  FontColor #7F6000
}
skinparam note {
  BackgroundColor #FFF2CC
  BorderColor #BF9000
}
hide members
hide circle

abstract class Persona
class Estudiante
class Docente
class Usuario
class PeriodoAcademico
class Curso
class Corte
class Matricula
class Calificacion
class RegistroAuditoria
class EventoSeguridad

Persona <|-- Estudiante
Persona <|-- Docente
Persona "1" -- "1" Usuario : identifica >
Usuario "1" -- "0..*" RegistroAuditoria : genera >
Usuario "0..1" -- "0..*" EventoSeguridad : origina >

PeriodoAcademico "1" -- "0..*" Curso : ofrece >
Docente "0..1" -- "0..*" Curso : dicta >
Curso "1" *-- "1..*" Corte : define >

Estudiante "1" -- "0..*" Matricula : cursa >
Curso "1" -- "0..*" Matricula : recibe >
Matricula "1" *-- "0..*" Calificacion : contiene >
Corte "1" -- "0..*" Calificacion : evalúa >
@enduml
