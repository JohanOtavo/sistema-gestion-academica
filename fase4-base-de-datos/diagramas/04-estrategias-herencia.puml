@startuml 04-estrategias-herencia
!pragma layout smetana
skinparam dpi 160
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #1F3864
skinparam class {
  BorderColor #2E75B6
  BackgroundColor #FFFFFF
  FontColor #1F3864
  HeaderBackgroundColor #DEEBF7
  AttributeFontSize 10
}
skinparam note {
  BackgroundColor #FFF2CC
  BorderColor #BF9000
}
skinparam package {
  BorderColor #808080
  BackgroundColor #F8F8F8
  FontColor #404040
}
hide circle

title Tres formas de llevar la jerarquia Persona a tablas

package "A. Tabla unica" {
  entity persona_unica as "persona" {
    id_persona : PK
    --
    datos comunes
    tipo : ESTUDIANTE o DOCENTE
    codigo_estudiante : nulo si es docente
    fecha_nacimiento : nulo si es docente
    codigo_docente : nulo si es estudiante
    area_conocimiento : nulo si es estudiante
  }
  note bottom of persona_unica
    Rapida: sin uniones.
    Cuesta: columnas que deben admitir
    nulos, de modo que el motor no puede
    exigir los datos obligatorios de cada
    subtipo.
  end note
}

package "B. Tabla por subtipo" {
  entity estudiante_solo as "estudiante" {
    id_estudiante : PK
    --
    datos comunes repetidos
    codigo_estudiante
  }
  entity docente_solo as "docente" {
    id_docente : PK
    --
    datos comunes repetidos
    codigo_docente
  }
  note bottom of docente_solo
    Cada subtipo es independiente.
    Cuesta: RN-01 se vuelve inaplicable,
    porque el documento tendria que ser
    unico entre dos tablas distintas.
  end note
}

package "C. Tabla por clase: la elegida" {
  entity persona_base as "persona" {
    id_persona : PK
    --
    numero_documento : UQ
    datos comunes
    estado
  }
  entity estudiante_hija as "estudiante" {
    id_persona : PK, FK
    --
    codigo_estudiante
    fecha_nacimiento
  }
  entity docente_hija as "docente" {
    id_persona : PK, FK
    --
    codigo_docente
    area_conocimiento
  }
  persona_base ||--o| estudiante_hija
  persona_base ||--o| docente_hija
  note bottom of persona_base
    RN-01 se cumple con una sola
    restriccion UNIQUE, y los atributos
    de cada subtipo se declaran
    obligatorios.
    Cuesta: una union por consulta, que
    las vistas vw_estudiante y vw_docente
    encapsulan.
  end note
}
@enduml
